<%= render DS::Card.new do %>
  <%= render DS::EmptyState.new(
    icon: "chart-bar",
    title: t("reports.empty_state.title"),
    description: t("reports.empty_state.description")
  ) do |es| %>
    <% es.with_action do %>
      <div class="flex flex-wrap gap-2 justify-center">
        <%= render DS::Link.new(
          text: t("reports.empty_state.add_transaction"),
          href: new_transaction_path,
          variant: "primary",
          frame: :modal
        ) %>
        <%= ask_chip t("reports.empty_state.ask_report"), hint: t("saved_reports.ask_draft_hint") %>
      </div>
    <% end %>
  <% end %>
<% end %>
