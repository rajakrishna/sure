<%# locals: (calendar:) %>

<div data-testid="cash-flow-calendar">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <div class="flex items-center gap-1 min-w-0">
      <%= render DS::Link.new(
            icon: "chevron-left",
            variant: "ghost",
            href: plan_path(tab: "forecast", month: calendar.previous_month.strftime("%Y-%m")),
            "aria-label": t("plans.cash_flow_calendar.previous_month")
          ) %>
      <%= render DS::Link.new(
            icon: "chevron-right",
            variant: "ghost",
            href: plan_path(tab: "forecast", month: calendar.next_month.strftime("%Y-%m")),
            "aria-label": t("plans.cash_flow_calendar.next_month")
          ) %>
      <h3 class="text-sm font-medium text-primary ml-2 truncate"><%= l(calendar.month, format: "%B %Y") %></h3>
    </div>
    <p class="text-xs text-secondary privacy-sensitive">
      <%= t("plans.cash_flow_calendar.month_net", amount: format_money(calendar.month_net)) %>
    </p>
  </div>

  <div class="hidden md:block rounded-lg overflow-hidden border border-primary">
    <div class="grid grid-cols-7 text-xs font-medium text-secondary uppercase bg-surface-inset">
      <% (0..6).each do |offset| %>
        <div class="px-2 py-1"><%= t("date.abbr_day_names")[offset] %></div>
      <% end %>
    </div>
    <div class="grid grid-cols-7">
      <% calendar.days.each do |day| %>
        <div class="min-h-24 p-1.5 space-y-1 border-t border-primary <%= "opacity-40" unless day.in_month %>">
          <div class="flex items-center justify-between gap-1">
            <p class="text-xs <%= day.date == Date.current ? "font-medium text-link" : "text-secondary" %>">
              <%= day.date.day %>
            </p>
            <% if day.running_balance %>
              <p class="text-[11px] tabular-nums privacy-sensitive <%= day.running_balance.negative? ? "text-destructive" : "text-subdued" %>">
                <%= format_money(day.running_balance) %>
              </p>
            <% end %>
          </div>
          <% day.events.each do |event| %>
            <%= link_to event.href, class: "block truncate text-[11px] rounded-sm px-1 py-0.5 #{event.kind == "income" ? "bg-success/10 text-success" : "bg-warning/10 text-warning"}" do %>
              <%= event.name %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="md:hidden space-y-1 rounded-xl bg-container-inset p-1">
    <% if calendar.agenda_days.empty? %>
      <div class="bg-container rounded-lg p-4">
        <p class="text-sm text-secondary"><%= t("plans.cash_flow_calendar.empty_month") %></p>
      </div>
    <% else %>
      <% calendar.agenda_days.each do |day| %>
        <div class="bg-container rounded-lg p-3 space-y-1.5">
          <div class="flex items-center justify-between gap-2">
            <p class="text-xs font-medium <%= day.date == Date.current ? "text-link" : "text-secondary" %> uppercase">
              <%= l(day.date, format: :long) %>
            </p>
            <% if day.running_balance %>
              <p class="text-xs tabular-nums privacy-sensitive <%= day.running_balance.negative? ? "text-destructive" : "text-primary" %>">
                <%= format_money(day.running_balance) %>
              </p>
            <% end %>
          </div>
          <% day.events.each do |event| %>
            <%= link_to event.href, class: "flex items-center justify-between gap-2 text-sm" do %>
              <span class="truncate text-primary"><%= event.name %></span>
              <span class="shrink-0 tabular-nums privacy-sensitive <%= event.kind == "income" ? "text-success" : "text-primary" %>">
                <%= format_money(event.amount) %>
              </span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
