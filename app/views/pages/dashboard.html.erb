<% content_for :page_header do %>
  <div class="mb-6 flex gap-4 justify-between items-center">
    <div class="min-w-0 space-y-0.5">
      <h1 class="text-xl font-medium text-primary truncate">
        <%= t("pages.dashboard.welcome", name: Current.user.first_name) %>
      </h1>
      <p class="text-sm text-secondary">
        <%= t("pages.dashboard.subtitle") %>
      </p>
    </div>

    <div class="flex items-center gap-2">
      <%= render DS::Link.new(
        icon: "plus",
        text: t("pages.dashboard.new"),
        href: new_account_path,
        frame: :modal,
        class: "hidden lg:inline-flex"
      ) %>

      <%= render DS::Link.new(
          variant: "icon-inverse",
          icon: "plus",
          href: new_account_path,
          frame: :modal,
          class: "rounded-full lg:hidden"
        ) %>
    </div>
  </div>
<% end %>

<%= turbo_frame_tag "dashboard_sections", target: "_top" do %>
  <% if accessible_accounts.any? && @home_snapshot %>
    <%= render "pages/dashboard/home_overview", snapshot: @home_snapshot %>
  <% end %>

  <% if accessible_accounts.any? %>
    <div class="flex items-center justify-end mb-4">
      <%= render UI::PeriodPicker.new(selected: @period, url: root_path, frame: "dashboard_sections") %>
    </div>
  <% end %>

  <% two_column = Current.user.dashboard_two_column? %>
  <% visible_sections = Array(@dashboard_sections).select { |section| section[:visible] } %>
  <% insight_sections = visible_sections.select { |section| section[:key] == "insights_feed" } %>
  <% chart_sections = visible_sections.reject { |section| section[:key] == "insights_feed" } %>

  <div class="grid grid-cols-1 gap-4 pb-4" role="list" aria-label="<%= t("pages.dashboard.priority_aria_label") %>">
    <% insight_sections.each do |section| %>
      <%= render "pages/dashboard/section", section: section, two_column: false %>
    <% end %>
  </div>

  <% if accessible_accounts.any? && chart_sections.any? %>
    <%= render DS::Disclosure.new(
          title: t("pages.dashboard.analytics"),
          align: "left",
          variant: :card,
          open: true,
          id: "home-analytics",
          data: { testid: "home-analytics" }
        ) do %>
      <div class="grid grid-cols-1 <%= "2xl:grid-cols-2 2xl:items-start 2xl:gap-y-0 2xl:[grid-auto-flow:row_dense] 2xl:[grid-auto-rows:1px]" if two_column %> gap-6" data-controller="dashboard-sortable dashboard-masonry" data-action="dragover->dashboard-sortable#dragOver drop->dashboard-sortable#drop" role="list" aria-label="<%= t("pages.dashboard.sections_aria_label") %>">
        <% chart_sections.each do |section| %>
          <%= render "pages/dashboard/section", section: section, two_column: two_column %>
        <% end %>
      </div>
    <% end %>
  <% elsif accessible_accounts.none? %>
    <section>
      <%= render "pages/dashboard/no_accounts_graph_placeholder" %>
    </section>
  <% end %>
<% end %>
