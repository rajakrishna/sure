<%# locals: (path: nil) %>
<% if preview_features_enabled? && Current.family.users.where.not(role: "guest").many? %>
  <%= render DS::SegmentedControl.new(aria_label: t("shared_views.label")) do |control| %>
    <% Family::SharedView.options_for(Current.family).each do |option| %>
      <% control.with_segment(
           option.label,
           active: shared_view.key == option.key,
           href: url_for(request.query_parameters.merge(view: option.key))
         ) %>
    <% end %>
  <% end %>
<% end %>
