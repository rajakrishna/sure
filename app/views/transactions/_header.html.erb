<%# locals: (entry:) %>
<div class="flex items-start justify-between gap-4" id="<%= dom_id(entry, :header) %>">
  <div>
    <h3 class="font-medium flex items-center gap-2">
      <span class="text-2xl text-primary privacy-sensitive">
        <%= format_money -entry.amount_money %>
      </span>
      <span class="text-lg text-secondary">
        <%= entry.currency %>
      </span>
      <% if entry.transaction.transfer? %>
        <%= icon "arrow-left-right", size: "sm", class: "text-secondary" %>
      <% end %>
      <% if entry.linked? %>
        <span title="<%= t("transactions.transaction.linked_with_provider", provider: entry.account.provider_name&.titleize) %>" class="text-secondary">
          <%= icon("refresh-ccw", size: "sm") %>
        </span>
      <% end %>
    </h3>
    <div class="flex items-center gap-2">
      <span class="text-sm text-secondary">
        <%= entry.date ? I18n.l(entry.date, format: :long) : "—" %>
      </span>
      <% if entry.transaction.pending? %>
        <%= render DS::Pill.new(
          label: t("transactions.transaction.pending"),
          tone: :neutral,
          marker: false,
          icon: "clock",
          title: t("transactions.transaction.pending_tooltip")
        ) %>
      <% end %>
    </div>
  </div>
  <div class="flex flex-wrap items-center justify-end gap-1">
    <% if entry.transaction.intelligence_source.present? %>
      <%= render DS::Pill.new(
        label: t("transactions.transaction.intelligence"),
        tone: :info,
        marker: false,
        icon: "sparkles",
        title: t("transactions.show.intelligence")
      ) %>
    <% end %>

    <div data-controller="lazy-frame" data-lazy-frame-src-value="<%= transaction_explain_path(entry) %>">
      <%= render DS::Popover.new(variant: :button, placement: "bottom-end", max_width: "22rem", testid: "explain-trigger") do |popover| %>
        <% popover.with_button(
             text: t("transactions.show.explain"),
             icon: "sparkles",
             variant: "ghost",
             size: "sm",
             data: { action: "click->lazy-frame#load" }
           ) %>
        <% popover.with_custom_content do %>
          <%= turbo_frame_tag dom_id(entry, :explain), data: { lazy_frame_target: "frame" } do %>
            <div class="p-3 space-y-2" aria-live="polite">
              <p class="text-sm text-secondary"><%= t("transactions.explains.loading") %></p>
              <%= render DS::Skeleton.new(lines: 3) %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%= ask_chip t("transactions.show.ask_in_chat"),
          hint: t("transactions.show.ask_hint"),
          context: [ { type: "transaction", id: entry.transaction.id } ] %>

    <%= render DS::Button.new(
          text: t("transactions.show.suggest"),
          href: transaction_ai_action_path(entry, kind: "suggest"),
          method: :post,
          variant: "ghost",
          size: "sm",
          icon: "sparkles",
          frame: :modal
        ) %>

    <% if entry.transaction.splittable? %>
      <%= render DS::Button.new(
            text: t("transactions.index.ask_split"),
            href: transaction_ai_action_path(entry, kind: "split"),
            method: :post,
            variant: "ghost",
            size: "sm",
            icon: "split",
            frame: :modal
          ) %>
    <% end %>

    <%= render DS::Menu.new do |menu| %>
      <% menu.with_item(
            variant: "button",
            text: t("transactions.index.ask_merchant"),
            href: transaction_ai_action_path(entry, kind: "suggest"),
            method: :post,
            icon: "sparkles",
            frame: :modal) %>
      <% menu.with_item(
            variant: "button",
            text: t("transactions.index.ask_rule"),
            href: transaction_ai_action_path(entry, kind: "rule"),
            method: :post,
            icon: "git-branch",
            frame: :modal) %>
    <% end %>
  </div>
</div>
