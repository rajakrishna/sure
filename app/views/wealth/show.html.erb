<div class="space-y-6 pb-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0 space-y-0.5">
      <h1 class="text-xl font-medium text-primary"><%= t(".title") %></h1>
      <p class="text-sm text-secondary"><%= t(".subtitle") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= render DS::Button.new(
        text: t(".suggest"),
        href: suggest_wealth_path,
        method: :post,
        variant: "secondary",
        icon: "sparkles"
      ) %>
      <%= ask_chip t(".ask_idle_cash"), hint: t(".ask_idle_cash_hint") %>
      <%= render "shared/shared_view_switcher", path: wealth_path %>
    </div>
  </header>

  <div data-testid="wealth-hero">
    <%= render DS::Card.new(class: "gap-4") do %>
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-1">
          <p class="text-xs font-medium uppercase tracking-wide text-secondary"><%= t(".net_worth") %></p>
          <p class="text-3xl font-medium text-primary tabular-nums privacy-sensitive"><%= @snapshot.net_worth_money.format %></p>
          <div class="flex flex-wrap gap-4 text-sm">
            <p class="text-secondary">
              <%= t(".assets") %>
              <span class="text-primary tabular-nums privacy-sensitive"><%= @snapshot.assets_money.format %></span>
            </p>
            <p class="text-secondary">
              <%= t(".liabilities") %>
              <span class="text-primary tabular-nums privacy-sensitive"><%= @snapshot.liabilities_money.format %></span>
            </p>
          </div>
          <% if @forecast&.narration.present? %>
            <p class="text-sm text-primary"><%= @forecast.narration %></p>
          <% end %>
        </div>
        <div class="flex items-center gap-3">
          <%= render DS::ProgressRing.new(
            percent: @health.score,
            tone: @health.score >= 70 ? :success : (@health.score >= 40 ? :warning : :destructive),
            label: t(".health_score")
          ) %>
          <div>
            <p class="text-xs text-secondary"><%= t(".health_score") %></p>
            <p class="text-lg font-medium text-primary tabular-nums"><%= @health.score %></p>
          </div>
        </div>
      </div>

      <% if @sparkline_series.size >= 2 %>
        <div class="text-success">
          <%= render DS::Sparkline.new(
            series: @sparkline_series,
            aria_label: t(".net_worth_trend"),
            css: "w-full max-w-md text-success"
          ) %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if Array(@health.actions).any? %>
    <div class="bg-container rounded-xl shadow-border-xs divide-y divide-subdued">
      <% Array(@health.actions).first(3).each do |action| %>
        <div class="flex items-center gap-3 px-4 py-3">
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-primary"><%= t("financial_health.components.#{action["key"]}") %></p>
            <p class="text-sm text-secondary"><%= action["detail"] %></p>
          </div>
          <%= ask_chip t(".ask_focus"), hint: t(".ask_focus_hint", detail: action["detail"]) %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render "ai_proposals/list", proposals: @ai_proposals %>

  <%= render DS::Disclosure.new(title: t(".allocation"), align: "left", variant: :card, open: true) do %>
    <% if @snapshot.allocation.any? %>
      <ul class="space-y-2">
        <% @snapshot.allocation.first(8).each do |slice| %>
          <li class="flex items-center justify-between gap-3 text-sm">
            <span class="text-primary truncate"><%= slice.label %></span>
            <span class="tabular-nums text-secondary privacy-sensitive"><%= slice.weight %>%</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-secondary"><%= t(".empty_allocation") %></p>
    <% end %>
  <% end %>

  <%= render DS::Disclosure.new(title: t(".health_components"), align: "left", variant: :card) do %>
    <ul class="space-y-3">
      <% Array(@health.components).each do |component| %>
        <% key = component.respond_to?(:key) ? component.key : component["key"] %>
        <% score = component.respond_to?(:score) ? component.score : component["score"] %>
        <% detail = component.respond_to?(:detail) ? component.detail : component["detail"] %>
        <li>
          <div class="flex items-center justify-between gap-3">
            <span class="text-sm text-primary"><%= t("financial_health.components.#{key}") %></span>
            <span class="text-sm tabular-nums text-secondary"><%= score %></span>
          </div>
          <p class="text-xs text-secondary mt-1"><%= detail %></p>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
