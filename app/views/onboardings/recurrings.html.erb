<%= content_for :previous_path, preferences_onboarding_path %>

<%= content_for :header_nav do %>
  <%= render "onboardings/onboarding_nav", user: @user %>
<% end %>

<div class="grow max-w-lg w-full mx-auto bg-surface flex flex-col justify-center md:py-0 py-6 px-4 md:px-0">
  <div class="space-y-1 mb-6">
    <h1 class="text-2xl font-medium"><%= t(".title") %></h1>
    <p class="text-secondary text-sm"><%= t(".subtitle") %></p>
  </div>

  <% if @board.items.any? %>
    <ul class="space-y-2 mb-6">
      <% @board.items.first(8).each do |item| %>
        <li class="flex items-center justify-between gap-3 bg-container rounded-lg px-3 py-2 shadow-border-xs">
          <span class="text-sm text-primary truncate"><%= item.name %></span>
          <span class="text-sm tabular-nums text-secondary"><%= format_money(item.amount) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <div class="flex flex-wrap gap-2">
    <%= render DS::Link.new(text: t(".continue"), href: goals_onboarding_path) %>
    <%= render DS::Link.new(text: t(".skip"), href: goals_onboarding_path, variant: "ghost") %>
  </div>
</div>
