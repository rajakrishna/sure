<%# locals: (nudges:) %>
<% if nudges.present? %>
  <div class="flex flex-wrap items-center gap-2">
    <% nudges.each do |nudge| %>
      <%= ask_chip(
            t("budget_nudges.#{nudge.status}_title", name: nudge.name, percent: nudge.percent),
            hint: t("budget_nudges.ask_adjust_hint", name: nudge.name)
          ) %>
    <% end %>
  </div>
<% end %>
