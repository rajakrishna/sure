<%# locals: (presentations:) %>
<% presentations.each do |presentation| %>
  <% chart = presentation[:chart] %>
  <% if chart.present? %>
    <% chart = chart.with_indifferent_access %>
    <% if chart[:type] == "sparkline" %>
      <% series = Array(chart[:points]).filter_map { |point| point = point.with_indifferent_access; [ Date.iso8601(point[:date].to_s), point[:value].to_f ] if point[:date].present? } %>
      <% if series.size >= 2 %>
        <div class="mt-3">
          <%= render DS::Sparkline.new(series: series, aria_label: chart[:aria_label].presence || t("assistant.charts.spending")) %>
        </div>
      <% end %>
    <% elsif chart[:type] == "breakdown" %>
      <ul class="mt-3 space-y-1">
        <% Array(chart[:points]).each do |point| %>
          <% point = point.with_indifferent_access %>
          <li class="flex items-center justify-between gap-2 text-sm">
            <span class="text-secondary truncate"><%= point[:label] %></span>
            <span class="text-primary privacy-sensitive shrink-0"><%= point[:formatted] %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <% if presentation[:deep_links].present? %>
    <div class="mt-3 flex flex-wrap gap-2">
      <% presentation[:deep_links].each do |link| %>
        <% link = link.with_indifferent_access %>
        <%= render DS::Link.new(text: link[:label], href: link[:path], size: "sm") if link[:path].present? %>
      <% end %>
    </div>
  <% end %>
<% end %>
