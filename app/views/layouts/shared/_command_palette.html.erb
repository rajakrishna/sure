<div data-controller="command-palette" class="contents">
  <button type="button"
          class="hidden lg:inline-flex items-center gap-2 h-9 px-3 rounded-lg text-sm text-secondary hover:text-primary hover:bg-container-inset-hover transition-colors focus-ring"
          data-action="command-palette#open"
          data-testid="command-palette-trigger"
          aria-label="<%= t("command_palette.open") %>">
    <%= icon("search", size: "sm") %>
    <span><%= t("command_palette.open") %></span>
    <kbd class="text-xs text-subdued">⌘K</kbd>
  </button>

  <dialog data-command-palette-target="dialog"
          class="w-full max-w-lg rounded-xl bg-container shadow-border-xs p-0 backdrop:bg-surface/60"
          data-testid="command-palette">
    <div class="p-3 border-b border-tertiary">
      <input type="search"
             data-command-palette-target="input"
             data-action="input->command-palette#filter"
             placeholder="<%= t("command_palette.placeholder") %>"
             class="w-full bg-transparent text-primary text-sm focus:outline-hidden">
    </div>
    <ul class="max-h-80 overflow-y-auto p-2">
      <% CommandPalette.new(user: Current.user).items.each do |item| %>
        <li data-command-palette-target="item"
            data-command-palette-search-value="<%= [item.name, item.hint].compact.join(" ") %>">
          <%= link_to item.path,
                class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-primary hover:bg-container-inset-hover",
                data: { action: "command-palette#close" } do %>
            <%= icon(item.icon, size: "sm") %>
            <span class="min-w-0 flex-1 truncate"><%= item.name %></span>
            <% if item.hint.present? %>
              <span class="text-xs text-secondary"><%= item.hint %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </dialog>
</div>
