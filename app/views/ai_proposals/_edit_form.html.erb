<%# locals: (proposal:) %>
<%= styled_form_with scope: :ai_proposal, url: ai_proposal_path(proposal), method: :patch, class: "space-y-3 mt-3" do |f| %>
  <% if proposal.kind == "categorize" %>
    <%= render DS::CategorySelect.new(
      form: f,
      categories: Current.family.categories,
      selected_id: proposal.payload["category_id"]
    ) %>
  <% elsif proposal.kind == "create_rule" %>
    <% args = proposal.payload["arguments"] || {} %>
    <div class="form-field">
      <%= label_tag "ai_proposal_name", t("ai_proposals.edit.rule_name"), class: "form-field__label" %>
      <%= text_field_tag "ai_proposal[name]", args["name"], class: "form-field__input" %>
    </div>
    <div class="form-field">
      <%= label_tag "ai_proposal_match_value", t("ai_proposals.edit.match_value"), class: "form-field__label" %>
      <%= text_field_tag "ai_proposal[match_value]", args["match_value"], class: "form-field__input" %>
    </div>
    <%= render DS::CategorySelect.new(
      form: f,
      categories: Current.family.categories,
      selected_id: args["category_id"]
    ) %>
  <% else %>
    <% (proposal.payload["arguments"] || {}).each do |key, value| %>
      <% next if value.is_a?(Array) || value.is_a?(Hash) %>
      <div class="form-field">
        <%= label_tag "ai_proposal_arguments_#{key}", key.humanize, class: "form-field__label" %>
        <%= text_field_tag "ai_proposal[arguments][#{key}]", value, class: "form-field__input" %>
      </div>
    <% end %>
  <% end %>

  <%= f.submit t("ai_proposals.edit.save") %>
<% end %>
