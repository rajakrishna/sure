<%# locals: (budget:) %>

<% if budget.initialized? %>
  <div class="w-full bg-container rounded-xl shadow-border-xs p-4" data-testid="flex-summary">
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="min-w-0">
        <h2 class="text-sm font-medium text-primary"><%= t(".heading") %></h2>
        <p class="text-xs text-secondary mt-0.5"><%= t(".subtitle") %></p>
      </div>
      <%= render DS::Pill.new(label: t("shared.preview")) %>
    </div>

    <dl class="space-y-2">
      <div class="flex items-baseline justify-between gap-3">
        <dt class="text-sm text-secondary"><%= t(".envelope") %></dt>
        <dd class="text-sm font-medium text-primary tabular-nums privacy-sensitive">
          <%= format_money budget.flex_envelope_money %>
        </dd>
      </div>
      <div class="flex items-baseline justify-between gap-3">
        <dt class="text-sm text-secondary"><%= t(".spent") %></dt>
        <dd class="text-sm text-secondary tabular-nums privacy-sensitive">
          <%= format_money Money.new(budget.flex_actual_spending, budget.currency) %>
        </dd>
      </div>
      <div class="flex items-baseline justify-between gap-3 border-t border-subdued pt-2">
        <dt class="text-sm font-medium text-primary"><%= t(".left") %></dt>
        <dd class="text-lg font-medium tabular-nums privacy-sensitive <%= budget.flex_available.negative? ? "text-destructive" : "text-primary" %>">
          <%= format_money Money.new(budget.flex_available, budget.currency) %>
        </dd>
      </div>
    </dl>
  </div>
<% end %>
