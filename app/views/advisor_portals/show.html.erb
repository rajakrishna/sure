<div class="space-y-6">
  <header class="space-y-1">
    <p class="text-sm text-secondary"><%= t(".read_only") %></p>
    <h1 class="text-2xl font-semibold text-primary"><%= t(".title", family: @invite.family.name) %></h1>
  </header>

  <%= render DS::Card.new do %>
    <p class="text-sm text-secondary"><%= t(".net_worth") %></p>
    <p class="text-3xl font-medium text-primary tabular-nums mt-2"><%= @snapshot.net_worth_money.format %></p>
    <p class="text-sm text-secondary mt-4"><%= t(".health_score") %>: <span class="text-primary tabular-nums"><%= @health_score %></span></p>
  <% end %>

  <%= render DS::Card.new do %>
    <h2 class="text-sm font-medium text-primary mb-3"><%= t(".allocation") %></h2>
    <ul class="space-y-2">
      <% @snapshot.allocation.first(8).each do |slice| %>
        <li class="flex items-center justify-between gap-3 text-sm">
          <span class="text-primary"><%= slice.label %></span>
          <span class="text-secondary tabular-nums"><%= slice.weight %>%</span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if @health_actions.present? %>
    <%= render DS::Card.new do %>
      <h2 class="text-sm font-medium text-primary mb-3"><%= t(".actions") %></h2>
      <ul class="space-y-2 text-sm text-secondary">
        <% Array(@health_actions).each do |action| %>
          <li><%= action.is_a?(Hash) ? action["detail"] : action %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
