<%# locals: (saved_reports:, period_type:, start_date:, end_date:, view_key:) %>
<%= render DS::Card.new(class: "mb-4") do %>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="text-sm font-medium text-primary"><%= t("saved_reports.heading") %></h2>
        <p class="text-xs text-secondary mt-1"><%= t("saved_reports.help") %></p>
      </div>
      <%= render "shared/shared_view_switcher", path: reports_path %>
    </div>

    <% if saved_reports.any? %>
      <ul class="mt-4 space-y-2">
        <% saved_reports.each do |report| %>
          <li class="flex items-center justify-between gap-3">
            <%= link_to report.name, reports_path(report.to_filter_params), class: "text-sm text-primary hover:underline" %>
            <%= render DS::Button.new(
              text: t("saved_reports.delete"),
              href: saved_report_path(report),
              method: :delete,
              variant: "ghost"
            ) %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= form_with model: SavedReport.new, url: saved_reports_path, class: "mt-4 flex flex-wrap items-end gap-3" do |form| %>
      <%= form.text_field :name, placeholder: t("saved_reports.name_placeholder"), class: "rounded-lg border border-primary bg-container-inset text-primary text-sm px-3 py-2" %>
      <%= hidden_field_tag "saved_report[config][period_type]", period_type %>
      <%= hidden_field_tag "saved_report[config][start_date]", start_date %>
      <%= hidden_field_tag "saved_report[config][end_date]", end_date %>
      <%= hidden_field_tag "saved_report[config][shared_view]", view_key %>
      <%= hidden_field_tag "saved_report[config][sections][]", "net_worth" %>
      <%= hidden_field_tag "saved_report[config][sections][]", "trends_insights" %>
      <%= hidden_field_tag "saved_report[config][sections][]", "transactions_breakdown" %>
      <%= render DS::Button.new(text: t("saved_reports.save"), type: :submit, variant: "secondary") %>
    <% end %>
  <% end %>
