<div class="space-y-6 pb-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-medium text-primary"><%= t(".title") %></h1>
      <p class="text-sm text-secondary mt-1"><%= l(@board.month, format: :month_year) %></p>
    </div>
    <%= render DS::Link.new(text: t("pages.dashboard.home.view_bills"), href: bills_path, variant: "outline") %>
  </header>

  <% if @board.items.any? %>
    <%= render DS::Card.new do %>
      <ul class="divide-y divide-secondary">
        <% @board.items.each do |item| %>
          <li class="py-3 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <%= link_to item.name, item.href, class: "text-sm font-medium text-primary truncate block" %>
              <p class="text-xs text-secondary"><%= t(".due") %> · <%= l(item.due_on, format: :long) %> · <%= item.status %></p>
            </div>
            <span class="text-sm tabular-nums privacy-sensitive text-primary"><%= format_money(item.amount) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <%= render DS::EmptyState.new(icon: "repeat", title: t(".empty")) %>
  <% end %>
</div>
