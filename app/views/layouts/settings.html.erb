<% content_for :sidebar do %>
  <%= render "settings/settings_nav" %>
<% end %>

<% content_for :page_header do %>
  <div class="max-w-4xl mx-auto mb-4 flex items-center justify-between gap-4 min-h-9">
    <% if content_for?(:page_title) %>
      <h1 class="text-primary text-xl font-medium">
        <%= yield :page_title %>
      </h1>
    <% else %>
      <div></div>
    <% end %>
    <% if content_for?(:page_actions) %>
      <div class="flex items-center gap-2 shrink-0">
        <%= yield :page_actions %>
      </div>
    <% end %>
  </div>
<% end %>

<% content_for :settings_body do %>
  <div class="max-w-4xl mx-auto space-y-4 pb-20">
    <%= yield %>
    <%= settings_nav_footer_mobile %>
    <div class="my-4 hidden md:block">
      <%= settings_nav_footer %>
    </div>
  </div>
<% end %>

<%= render template: "layouts/application" %>
