<div class="space-y-6 pb-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-medium text-primary"><%= t(".title") %></h1>
      <p class="text-sm text-secondary mt-1"><%= t(".subtitle") %></p>
    </div>
    <%= ask_chip t("pages.dashboard.home.ask_review"), hint: t("pages.dashboard.home.ask_review_hint") %>
  </header>

  <%= render "ai_proposals/quality", stats: @quality_stats %>

  <%= form_with url: ai_proposals_path, method: :get, class: "flex flex-wrap items-end gap-3" do %>
    <div>
      <label class="text-sm text-secondary" for="kind"><%= t(".filter_kind") %></label>
      <%= select_tag :kind,
            options_for_select([[t(".all"), ""]] + @kinds.map { |kind| [t("ai_proposals.kinds.#{kind}"), kind] }, @kind),
            class: "mt-1 block rounded-lg border border-primary bg-container-inset text-primary text-sm px-3 py-2" %>
    </div>
    <%= render DS::Button.new(text: t(".apply"), type: :submit, variant: "secondary") %>
  <% end %>

  <% if @ai_proposals.any? %>
    <%= form_with url: bulk_approve_ai_proposals_path, method: :post, class: "space-y-4" do %>
      <div class="flex flex-wrap gap-2">
        <%= render DS::Button.new(text: t(".bulk_approve"), type: :submit, variant: "primary") %>
        <button type="submit" formaction="<%= bulk_dismiss_ai_proposals_path %>" class="btn btn--ghost">
          <%= t(".bulk_dismiss") %>
        </button>
      </div>
      <div class="space-y-3">
        <% @ai_proposals.each do |proposal| %>
          <div class="flex items-start gap-3">
            <label class="mt-4">
              <span class="sr-only"><%= t(".select") %></span>
              <%= check_box_tag "proposal_ids[]", proposal.id, false, class: "checkbox" %>
            </label>
            <div class="min-w-0 flex-1">
              <%= render "ai_proposals/card", proposal: proposal %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <%= render DS::EmptyState.new(icon: "sparkles", title: t(".empty")) %>
  <% end %>
</div>
