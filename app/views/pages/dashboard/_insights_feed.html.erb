<%# locals: (insights:, **args) %>

<div id="insights-feed" class="px-4 -mt-2">
  <div class="bg-container-inset rounded-xl p-1 space-y-1">
    <div class="px-4 py-2 flex items-center justify-between uppercase text-xs font-medium text-secondary">
      <% new_count = insights.count(&:active?) %>
      <div class="flex items-center gap-2">
        <% if new_count.positive? %>
          <p><%= t("insights.feed.header_new") %><span class="text-subdued mx-1">&middot;</span><%= new_count %></p>
        <% else %>
          <p><%= t("insights.feed.header") %></p>
        <% end %>
      </div>
    </div>

    <div class="py-1.5 shadow-border-xs rounded-lg bg-container text-sm">
      <% insights.each do |insight| %>
        <div class="relative flex items-center mx-3 px-3 py-2.5 rounded-lg gap-3 group/insight">

          <%= render DS::FilledIcon.new(
            icon: insight_icon_key(insight),
            hex_color: insight_icon_css_color(insight),
            size: "md",
            rounded: true,
            class_name: "motion-safe:group-hover/insight:scale-105 motion-safe:transition-all motion-safe:duration-150"
          ) %>

          <div class="min-w-0 grow">
            <%# No per-row "New" pill: the well's header already counts the
                unread ones ("New · 3"), and with only three rows the pill was
                usually on all of them — saying the same thing twice while
                crowding the title. %>
            <span class="text-sm font-medium text-primary truncate block"><%= insight_privacy_text(insight.title) %></span>
            <p class="text-sm text-secondary truncate"><%= insight_privacy_text(insight.body) %></p>
          </div>

          <% if (figure = insight_key_figure(insight)) %>
            <div class="text-right shrink-0">
              <p class="text-sm font-medium whitespace-nowrap privacy-sensitive <%= insight_sentiment(insight) == :positive ? "text-success" : "text-primary" %>"><%= figure.first %></p>
              <p class="text-xs text-secondary whitespace-nowrap"><%= figure.last %></p>
            </div>
          <% end %>

          <%# Acknowledging used to be possible only on /insights, so the surface
              people actually look at couldn't clear anything. `relative z-10`
              lifts this above the stretched link. Visibility is progressive and
              never hover-only: pointer hover, keyboard focus, and always shown
              on touch, where there is no hover to reveal it. No gesture, so the
              section's drag-to-reorder handlers are untouched.

              The group is *named*: the dashboard <section> wrapping this widget
              is itself a `.group` (for its header controls), and a bare
              `group-hover:` matches any ancestor group — so hovering one row, or
              even the section header, revealed the control on every row. %>
          <div class="relative z-10 shrink-0 flex items-center gap-1 opacity-0 group-hover/insight:opacity-100 group-focus-within/insight:opacity-100 pointer-coarse:opacity-100 transition-opacity">
            <%= render DS::Popover.new(variant: :button, placement: "bottom-end", max_width: "22rem", testid: "insight-explain") do |popover| %>
              <% popover.with_button(
                   variant: "icon",
                   size: "sm",
                   icon: "sparkles",
                   title: t("insights.feed.explain"),
                   aria: { label: t("insights.feed.explain_aria", title: insight.title) }
                 ) %>
              <% popover.with_custom_content do %>
                <div class="p-3 space-y-2">
                  <p class="text-sm font-medium text-primary"><%= insight_privacy_text(insight.title) %></p>
                  <p class="text-sm text-secondary"><%= insight_privacy_text(insight.body) %></p>
                  <%= ask_chip t("insights.feed.ask"),
                        hint: insight.title,
                        context: [ { type: "insight", id: insight.id } ] %>
                </div>
              <% end %>
            <% end %>
            <%= render DS::Button.new(
              variant: "icon",
              size: "sm",
              icon: "check",
              href: acknowledge_insight_path(insight),
              method: :patch,
              title: t("insights.card.acknowledge"),
              aria_label: t("insights.feed.acknowledge_aria", title: insight.title)
            ) %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
