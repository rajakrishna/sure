<%# locals: (entry:) %>
<div class="flex items-start justify-between gap-4" id="<%= dom_id(entry, :header) %>">
  <div>
    <h3 class="font-medium flex items-center gap-2">
      <span class="text-2xl text-primary privacy-sensitive">
        <%= format_money -entry.amount_money %>
      </span>
      <span class="text-lg text-secondary">
        <%= entry.currency %>
      </span>
      <% if entry.transaction.transfer? %>
        <%= icon "arrow-left-right", size: "sm", class: "text-secondary" %>
      <% end %>
      <% if entry.linked? %>
        <span title="<%= t("transactions.transaction.linked_with_provider", provider: entry.account.provider_name&.titleize) %>" class="text-secondary">
          <%= icon("refresh-ccw", size: "sm") %>
        </span>
      <% end %>
    </h3>
    <div class="flex items-center gap-2">
      <span class="text-sm text-secondary">
        <%= entry.date ? I18n.l(entry.date, format: :long) : "—" %>
      </span>
      <% if entry.transaction.pending? %>
        <%= render DS::Pill.new(
          label: t("transactions.transaction.pending"),
          tone: :neutral,
          marker: false,
          icon: "clock",
          title: t("transactions.transaction.pending_tooltip")
        ) %>
      <% end %>
    </div>
  </div>
  <div class="flex flex-wrap items-center justify-end gap-1">
    <% if entry.transaction.intelligence_source.present? %>
      <%= render DS::Pill.new(
        label: t("transactions.transaction.intelligence"),
        tone: :info,
        marker: false,
        icon: "sparkles",
        title: t("transactions.show.intelligence")
      ) %>
    <% end %>
    <%= ask_chip t("transactions.show.explain"),
          hint: t("transactions.show.explain_hint"),
          context: [ { type: "transaction", id: entry.transaction.id } ] %>
    <%= ask_chip t("transactions.show.ask_in_chat"),
          hint: t("transactions.show.ask_hint"),
          context: [ { type: "transaction", id: entry.transaction.id } ] %>
    <% if entry.transaction.splittable? %>
      <%= ask_chip t("transactions.index.ask_split"),
            hint: t("transactions.show.ask_split_hint"),
            context: [ { type: "transaction", id: entry.transaction.id } ] %>
    <% end %>
    <%= render DS::Menu.new do |menu| %>
      <% menu.with_item(
            variant: "link",
            text: t("transactions.index.ask_merchant"),
            href: ask_in_chat_href(t("transactions.show.ask_merchant_hint"), [ { type: "transaction", id: entry.transaction.id } ]),
            icon: "sparkles",
            frame: :sidebar_chat,
            data: { action: "click->app-layout#openRightSidebar" }) %>
      <% menu.with_item(
            variant: "link",
            text: t("transactions.index.ask_rule"),
            href: ask_in_chat_href(t("transactions.show.ask_rule_hint"), [ { type: "transaction", id: entry.transaction.id } ]),
            icon: "sparkles",
            frame: :sidebar_chat,
            data: { action: "click->app-layout#openRightSidebar" }) %>
    <% end %>
  </div>
</div>
