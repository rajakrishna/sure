<%# locals: (planner:) %>

<% extra_value = planner.extra_payment.zero? ? nil : planner.extra_payment %>
<div data-testid="debt-payoff-planner" class="mt-6">
  <div class="flex flex-wrap items-center gap-2 mb-3">
    <p class="text-[11px] font-medium uppercase tracking-wide text-secondary"><%= t("plans.debt_planner.title") %></p>
    <%= render DS::Pill.new(label: t("shared.preview")) %>
  </div>

  <%= render DS::SegmentedControl.new(aria_label: t("plans.debt_planner.strategy_aria")) do |control| %>
    <% control.with_segment(
         t("plans.debt_planner.avalanche"),
         active: planner.strategy == "avalanche",
         href: plan_path(tab: "debt", strategy: "avalanche", extra_payment: extra_value)
       ) %>
    <% control.with_segment(
         t("plans.debt_planner.snowball"),
         active: planner.strategy == "snowball",
         href: plan_path(tab: "debt", strategy: "snowball", extra_payment: extra_value)
       ) %>
  <% end %>
  <p class="text-xs text-secondary mt-2"><%= t("plans.debt_planner.#{planner.strategy}_hint") %></p>

  <%= form_with url: plan_path, method: :get, class: "flex flex-wrap items-end gap-3 mt-4" do %>
    <%= hidden_field_tag :tab, "debt" %>
    <%= hidden_field_tag :strategy, planner.strategy %>
    <div class="min-w-40">
      <label class="form-field__label" for="extra_payment"><%= t("plans.debt_planner.extra_payment") %></label>
      <%= number_field_tag :extra_payment,
            planner.extra_payment.zero? ? nil : planner.extra_payment,
            min: 0,
            step: 0.01,
            class: "form-field__input",
            placeholder: "0" %>
    </div>
    <%= render DS::Button.new(text: t("plans.debt_planner.update"), variant: "secondary", size: "sm", type: "submit") %>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-4">
    <div class="rounded-lg bg-surface-inset p-3">
      <p class="text-xs text-secondary"><%= t("plans.debt_planner.debt_free") %></p>
      <p class="text-sm font-medium text-primary mt-1">
        <% if planner.debt_free_on %>
          <%= l(planner.debt_free_on, format: :long) %>
        <% else %>
          <%= t("plans.debt_planner.no_date") %>
        <% end %>
      </p>
      <% if planner.capped %>
        <p class="text-xs text-warning mt-1"><%= t("plans.debt_planner.capped") %></p>
      <% end %>
    </div>
    <div class="rounded-lg bg-surface-inset p-3">
      <p class="text-xs text-secondary"><%= t("plans.debt_planner.interest") %></p>
      <p class="text-sm font-medium text-primary mt-1 tabular-nums privacy-sensitive"><%= format_money(planner.total_interest) %></p>
    </div>
    <div class="rounded-lg bg-surface-inset p-3">
      <p class="text-xs text-secondary"><%= t("plans.debt_planner.saved") %></p>
      <p class="text-sm font-medium text-primary mt-1 tabular-nums privacy-sensitive"><%= format_money(planner.interest_saved) %></p>
    </div>
  </div>

  <ol class="mt-4">
    <% planner.rows.each_with_index do |row, index| %>
      <li class="flex items-center gap-3 py-2.5 <%= "border-b border-divider" unless index == planner.rows.size - 1 %>">
        <span class="w-6 h-6 rounded-full bg-surface-inset text-xs font-medium text-secondary flex items-center justify-center shrink-0"><%= row.order %></span>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-primary truncate"><%= row.name %></p>
          <p class="text-xs text-subdued">
            <%= t("plans.debt_planner.rate", percent: row.rate) %>
            · <%= t("plans.debt_planner.min", amount: format_money(row.minimum)) %>
          </p>
        </div>
        <div class="text-right shrink-0">
          <p class="text-xs tabular-nums text-primary privacy-sensitive"><%= format_money(row.balance) %></p>
          <p class="text-xs text-subdued">
            <% if row.payoff_on %>
              <%= l(row.payoff_on, format: "%b %Y") %>
            <% else %>
              <%= t("plans.debt_planner.still_open") %>
            <% end %>
          </p>
        </div>
      </li>
    <% end %>
  </ol>
</div>
