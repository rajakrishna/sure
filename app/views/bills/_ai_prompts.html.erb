<%# locals: (prompts:) %>
<% if bills_one_shot_ai_available? %>
  <% visible_prompts = Array(prompts).first(2) %>
  <% extra_prompts = Array(prompts).drop(2) %>
  <div class="flex flex-wrap items-center gap-2">
    <% visible_prompts.each do |prompt| %>
      <%= ask_chip t(".#{prompt}"), hint: t(".#{prompt}") %>
    <% end %>
    <% if extra_prompts.any? %>
      <%= render DS::Disclosure.new(variant: :inline, title: nil, align: "left") do |disclosure| %>
        <% disclosure.with_summary_content do %>
          <span class="text-sm text-secondary"><%= t(".more") %></span>
        <% end %>
        <div class="flex flex-wrap items-center gap-2 mt-2">
          <% extra_prompts.each do |prompt| %>
            <%= ask_chip t(".#{prompt}"), hint: t(".#{prompt}") %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
